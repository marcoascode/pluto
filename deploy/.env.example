# Pluto Mídia — modelo do .env (copie para a raiz do projeto como .env e preencha).
# Este arquivo fica em deploy/ porque ".env.example" na raiz está no .gitignore (cópias locais com segredos).
# NUNCA commite valores reais.

# ---------- app ----------
APP_URL=https://app.plutomidia.com.br
APP_TZ=America/Sao_Paulo
# TRUST_PROXY=loopback, linklocal, uniquelocal
# COOKIE_SECURE=true
# SESSION_DAYS=7

# ---------- banco (docker-compose) ----------
POSTGRES_DB=pluto
POSTGRES_USER=pluto
POSTGRES_PASSWORD=troque-esta-senha

# ---------- primeiro boot ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ---------- criptografia dos tokens (AES-256-GCM) ----------
# 32 bytes em base64: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY tem prioridade; TOKEN_ENC_KEY é o nome antigo e continua aceito.
# Trocar a chave invalida todos os tokens já salvos (Perfis Meta, OAuth do Google/Meta, senhas WP).
TOKEN_ENCRYPTION_KEY=
# TOKEN_ENC_KEY=

# ---------- Meta (App do Pluto) ----------
# Usado pelo sync de relatórios (SuperAdmin), pelo Facebook Login dos Perfis de contingência (0.18.2) e pelo build do front.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
# Callback do Facebook Login dos Perfis. Padrão: ${APP_URL}/api/meta/oauth/callback
# Cadastre esta URL em developers.facebook.com → App → Login do Facebook → Configurações → "URIs de redirecionamento do OAuth válidos".
# META_OAUTH_REDIRECT_URI=https://app.plutomidia.com.br/api/meta/oauth/callback
# META_GRAPH_URL=https://graph.facebook.com
# META_CHUNK_DAYS=3
# META_RATE_LIMIT_WAIT_MS=60000
# META_RATE_LIMIT_RETRIES=5

# ---------- Google (Ads + Ad Manager) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25

# ---------- IA (copies das campanhas Meta) ----------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_TIMEOUT_MS=90000

# ---------- e-mail ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pluto Mídia <admin@plutomidia.com.br>

# ---------- sync ----------
# SCHEDULER_ENABLED=true
# SYNC_BACKFILL_DAYS=30
